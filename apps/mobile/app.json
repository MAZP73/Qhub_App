{
  "expo": {
    "name": "Qhub",
    "slug": "qhub",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "qhub",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e1330"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qhub.app"
    },
    "android": {
      "package": "com.qhub.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3b4eff"
      }
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "dc7a8386-2fda-4cbf-a350-93bd1fb7c4de"
      }
    },
    "owner": "qhub_app"
  }
}
