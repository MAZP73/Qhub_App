# App movil Qhub (Expo/Android). Variables de build incrustadas en el APK.
APP_ENV=production
# Supabase (publicas) — el movil habla con Supabase, no directo con la API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secretos solo para tool/ (migraciones, despliegue de Edge Functions). NUNCA en una app.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
APP_URLS=                          # URLs permitidas para auth redirects, separadas por coma
# Recordatorio: el secret QHUB_API_BASE_URL (URL publica de la API en Render) se pone en Supabase Edge Functions, no aqui.
# SMTP propio (opcional) para correos con marca:
# SMTP_HOST= / SMTP_PORT= / SMTP_USER= / SMTP_PASS= / SMTP_ADMIN_EMAIL=
