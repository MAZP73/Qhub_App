{
  "name": "qhub-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/mobile"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "bash tool/start.sh",
    "start:tunnel": "bash tool/start.sh --tunnel",
    "android": "bash tool/start.sh --android",
    "ios": "bash tool/start.sh --ios",
    "build:apk": "cd apps/mobile && npx eas-cli build -p android --profile preview",
    "build:android": "cd apps/mobile && npx eas-cli build -p android --profile production",
    "build:ios": "cd apps/mobile && npx eas-cli build -p ios --profile production"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "@types/react": "~19.3.0"
  }
}
