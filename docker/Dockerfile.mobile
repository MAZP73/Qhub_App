# App móvil (producción): el bundle de Android se compila con `expo export` y se sirve como archivos estáticos con nginx.
# Sirve para alojar el bundle (actualizaciones OTA); el APK/IPA firmado se genera con EAS Build. Las variables públicas llegan como argumentos de build desde el .env central (ver compose.yaml).
FROM node:22-bookworm-slim AS build
ENV NODE_OPTIONS=--dns-result-order=ipv4first npm_config_update_notifier=false npm_config_fund=false npm_config_audit=false EXPO_NO_TELEMETRY=1 CI=1
ARG EXPO_PUBLIC_APP_ENV
ARG EXPO_PUBLIC_SUPABASE_URL
ARG EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV EXPO_PUBLIC_APP_ENV=$EXPO_PUBLIC_APP_ENV EXPO_PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/mobile ./apps/mobile
RUN npm ci --workspace @qhub/mobile --include-workspace-root && npm run typecheck -w @qhub/mobile && npm run export -w @qhub/mobile -- --output-dir dist

FROM nginx:1.27-alpine
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  server_tokens off;\n  add_header X-Content-Type-Options nosniff;\n  add_header X-Frame-Options DENY;\n  location / { try_files $uri =404; }\n}\n' > /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/mobile/dist /usr/share/nginx/html
EXPOSE 80
