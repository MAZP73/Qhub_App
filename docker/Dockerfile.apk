# APK de la app móvil (Android), compilado en Docker y gratis: Expo prebuild + Gradle. Instalable directo en el teléfono (firmado con la llave de depuración, suficiente para instalar fuera de la tienda).
# Se usa con `tool/build-apk.sh`, que pasa las variables públicas del .env central y deja el archivo en ./apk/qhub.apk
FROM node:22-bookworm-slim AS build
ENV NODE_OPTIONS=--dns-result-order=ipv4first npm_config_update_notifier=false npm_config_fund=false npm_config_audit=false EXPO_NO_TELEMETRY=1 CI=1
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless unzip curl ca-certificates git python3 make g++ && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 ANDROID_HOME=/opt/android ANDROID_SDK_ROOT=/opt/android
ENV PATH=$PATH:/opt/android/cmdline-tools/latest/bin:/opt/android/platform-tools
RUN mkdir -p /opt/android/cmdline-tools && curl -fsSL -o /tmp/tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
 && unzip -q /tmp/tools.zip -d /opt/android/cmdline-tools && mv /opt/android/cmdline-tools/cmdline-tools /opt/android/cmdline-tools/latest && rm /tmp/tools.zip \
 && yes | sdkmanager --licenses >/dev/null && sdkmanager "platform-tools" "platforms;android-36" "build-tools;36.0.0"

# Arquitectura(s) nativas: arm64-v8a para teléfonos; x86_64 para el emulador de Android del PC (se pueden juntar con coma).
ARG ARCHS=arm64-v8a
ARG EXPO_PUBLIC_APP_ENV
ARG EXPO_PUBLIC_SUPABASE_URL
ARG EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV EXPO_PUBLIC_APP_ENV=$EXPO_PUBLIC_APP_ENV EXPO_PUBLIC_SUPABASE_URL=$EXPO_PUBLIC_SUPABASE_URL EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/mobile ./apps/mobile
RUN npm ci --workspace @qhub/mobile --include-workspace-root
WORKDIR /app/apps/mobile
RUN npx expo prebuild --platform android --no-install
# Solo arm64 (los teléfonos actuales): compila mucho más rápido y el APK pesa menos.
# El JVM que compila (no solo el lanzador) debe usar IPv4: sin esto Gradle falla con «Network is unreachable» al bajar dependencias.
RUN printf "\norg.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8 -Djava.net.preferIPv4Stack=true\norg.gradle.daemon=false\n" >> android/gradle.properties
ENV JAVA_TOOL_OPTIONS="-Djava.net.preferIPv4Stack=true"
# La caché de Gradle se conserva entre intentos (si falla la red, no se vuelve a bajar todo).
# El DNS de WSL falla a ratos («Temporary failure in name resolution»): se reintenta; lo ya descargado queda en la caché y cada vuelta avanza.
RUN --mount=type=cache,target=/root/.gradle cd android && for i in 1 2 3 4 5 6 7 8; do ./gradlew assembleRelease --no-daemon -PreactNativeArchitectures=$ARCHS && exit 0; echo "intento $i falló; reintentando…"; sleep 15; done; exit 1

FROM scratch AS apk
COPY --from=build /app/apps/mobile/android/app/build/outputs/apk/release/app-release.apk /qhub.apk
